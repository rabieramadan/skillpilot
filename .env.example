# SkillPilot environment configuration.
# Copy to `.env` and fill in real values. `.env` is git-ignored — never commit it.

# --- Core ------------------------------------------------------------------
# postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/skillpilot

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-character-random-string
SESSION_SECRET=change-this-to-a-64-character-random-string

FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# --- File uploads ----------------------------------------------------------
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads/

# --- AI providers ----------------------------------------------------------
# Every provider is optional; the app enables only the ones with a key.
# Keys may also be stored encrypted in the database via Admin > AI Settings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
DIFY_API_KEY=
HEYGEN_API_KEY=
CENSUS_API_KEY=

# AWS Bedrock: access_key|secret_key|region
BEDROCK_API_KEY=

# --- Optional model overrides ---------------------------------------------
# Override the default model for a provider without editing config.yaml.
# SKILLPILOT_MODEL_OPENAI=gpt-6-astra
# SKILLPILOT_MODEL_CLAUDE=claude-opus-5
# SKILLPILOT_MODEL_GEMINI=gemini-3.8-flash
