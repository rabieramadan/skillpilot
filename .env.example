# SkillPilot environment configuration.
# Copy to `.env` and fill in. `.env` is git-ignored — never commit it.
#
# AI provider keys are NOT here: they live in config.yaml under `api_keys:`,
# beside the model catalogue. Copy config.example.yaml to config.yaml and add
# them there. You can still set a key below to override config.yaml for this
# deployment only — an environment variable always wins.

# --- Core ------------------------------------------------------------------
# postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/skillpilot

# Session signing, and the key that encrypts credentials stored through
# Admin > AI Settings. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set it once: changing it logs everyone out and makes stored keys
# undecryptable. All workers on a server must share the same value.
SECRET_KEY=change-this-to-a-64-character-random-string
SESSION_SECRET=change-this-to-a-64-character-random-string

# Super-admin password login. Empty disables it, which is the safe default;
# sign in with the seeded admin account instead.
ADMIN_PASSWORD=

FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# --- File uploads ----------------------------------------------------------
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads/

# --- Optional overrides ----------------------------------------------------
# Any of these takes priority over the matching entry in config.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# PERPLEXITY_API_KEY=
# HEYGEN_API_KEY=
# DIFY_API_KEY=
# BEDROCK_API_KEY=

# Pin a model without editing config.yaml.
# SKILLPILOT_MODEL_OPENAI=gpt-6-astra
# SKILLPILOT_MODEL_CLAUDE=claude-opus-5

# Set to 0 to skip the provider reachability check at startup.
SKILLPILOT_STARTUP_CHECK=1
