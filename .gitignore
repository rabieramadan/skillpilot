# --- Secrets ---------------------------------------------------------------
# config.yaml holds the live API keys, so it stays on the server and is never
# committed. config.example.yaml is the tracked template: same model
# catalogue, keys blank.
config.yaml
!config.example.yaml

# .env holds the database URL and the session secret.
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# --- Runtime data ----------------------------------------------------------
# Never commit data dumps, user records or uploaded course material.
users.json
attendance.json
ethics_assessments.json
exports/
uploads/
backups/
course_files/
exam_data/
certificates/
server.log
instance/
*.db
*.sqlite3
logs/
*.log

# --- Node / tooling --------------------------------------------------------
node_modules/
dist/

# --- Editors & OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Archives & backups ----------------------------------------------------
*.tar.gz
*.rar
*.bak
*.bak[0-9]
*.lnk
Thumbs.db
desktop.ini
skillpilot_deployment/
config.local.yaml
config.yaml.tmp
